# Copy to .env (gitignored) — docker compose reads it automatically.

# AI insights. Groq is free: https://console.groq.com/keys
LLM_PROVIDER=Groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Local LLM instead (no key): install Ollama, run `ollama pull qwen3:8b`, then use
# LLM_PROVIDER=Ollama
# LLM_MODEL=qwen3:8b
# LLM_BASE_URL=http://host.docker.internal:11434/v1/

# Optional: override the local-only JWT signing key (>= 32 chars).
# JWT_KEY=
